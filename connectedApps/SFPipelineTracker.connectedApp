<?xml version="1.0" encoding="UTF-8"?>
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>SF Pipeline Tracker</label>
    <contactEmail>admin@example.com</contactEmail>
    <description>OAuth Connected App for SF Pipeline Tracker. After install: Setup → App Manager → SF Pipeline Tracker → copy Consumer Key.</description>
    <oauthConfig>
        <callbackUrl>https://romanbazylev.github.io/sf-progress--tracker/index.html</callbackUrl>
        <isAdminApproved>false</isAdminApproved>
        <isConsumerSecretOptional>true</isConsumerSecretOptional>
        <isIntrospectAllTokens>false</isIntrospectAllTokens>
        <scopes>Api</scopes>
        <scopes>RefreshToken</scopes>
    </oauthConfig>
    <oauthPolicy>
        <ipRelaxation>BYPASS</ipRelaxation>
        <refreshTokenPolicy>infinite</refreshTokenPolicy>
    </oauthPolicy>
</ConnectedApp>
